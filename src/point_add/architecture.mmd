flowchart TD
  Target["Target primitive: quantum P plus classical Q on secp256k1"]
  Algorithm["Algorithm"]
  Optimization["Optimization"]
  Target --> Algorithm
  Target --> Optimization
  Algorithm --> Contract["ABI: quantum target x and y; preserved classical offset x and y"]
  Algorithm --> Affine["Affine shell: coordinate differences, slope, output coordinates"]
  Optimization --> Exact["Exact generated optimization blocks"]

  Affine --> Pair1["Kaliski pair 1: full 511-round inverse, apply, and uncompute"]
  Pair1 --> Lambda["Remove inverse scale and form slope lambda"]
  Lambda --> XCoord["Form output x and second denominator"]
  XCoord --> Pair2["Kaliski pair 2: form output y while uncomputing lambda"]
  Pair2 --> Result["Overwrite target with P plus Q and clean all ancillas"]
  Contract --> Result

  Exact --> Square["Half-product exact square"]
  Square --> Identity["x equals a plus 2^128 b; use a^2, b^2, and (a+b)^2 sequentially"]
  Identity --> Fold["Apply five signed secp256k1 fold terms with full modular primitives"]
  Fold --> Bennett["Uncompute every 256 or 258-bit product and the 129-bit sum"]

  Exact --> Solinas["Exact Solinas power walk"]
  Solinas --> Walk["22 modular doubles; center add or subtract; 22 modular halves"]
  Walk --> Peak["Remove shift spill lifetime; peak moves to Kaliski step 4"]

  Exact --> Fanout["Source-bound epoch target-fanout pass"]
  Fanout --> Rule["CCX into temporary; commuting context; CX to output; inverse CCX becomes CX then CCX into output"]
  Rule --> Guard["36 disjoint witnesses checked by indices, lanes, conditions, depths, and stream sizes"]

  Result --> Validation["Hardened trusted validation"]
  Bennett --> Validation
  Peak --> Validation
  Guard --> Validation
  Validation --> Checks["102400 shots: classical correctness, reversibility, phase cleanliness, ancilla cleanup"]
  Validation --> Metrics["2820 qubits; 5211740 average Toffoli; score 14697106800"]
